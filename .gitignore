# ─── Bases CNES e DATASUS (baixar localmente, NUNCA versionar) ────────────────
# São arquivos grandes (centenas de MB) que devem ser baixados localmente
# pelo operador. Manter `data/def_medicamentos.csv` (6KB) versionado pois é
# referência local que o módulo de IA precisa para funcionar imediatamente.
data/BASE_DE_DADOS_CNES_*.ZIP
data/BASE_DE_DADOS_CNES_*.zip
data/cnes_br_tmp/
data/cnes_*_tmp/
data/estabelecimentos_*.csv
data/profissionais_*.csv
data/relacao_prof_estab_*.csv
data/backups/

# ─── Arquivos temporários do FUSE (mount virtual no sandbox cowork) ───────────
.fuse_hidden*

# ─── Cache de plugins / outputs do agente ─────────────────────────────────────
.claude/local-agent-mode-sessions/
outputs/

# ─── Outras configurações locais ──────────────────────────────────────────────
*.local

# ─── Relatórios gerados localmente ────────────────────────────────────────────
reports/

# ─── Config local de IDE/editor (Claude Code, VS Code, JetBrains etc.) ────────
.claude/
.idea/
.vscode/

# ─── Exceção: permitir que o template .env.example seja versionado ────────────
# (a regra .env.* acima pegaria .env.example; esta exceção a desfaz)
!.env.example

# ─── Outros utilitários de teste local ────────────────────────────────────────
debug_pydantic.py
