# ─────────────────────────────────────────────────────────────────────────────
# PicSaúde — Configuração de instância
# G5-impl: template oficial de variáveis de ambiente
#
# INSTRUÇÕES:
#   1. Copie este arquivo para .env (cp .env.example .env)
#   2. Preencha TODOS os campos marcados como OBRIGATÓRIO
#   3. NUNCA commite o .env em repositório de código
#   4. Execute ./bootstrap.sh após preencher
# ─────────────────────────────────────────────────────────────────────────────

# ── Identificação da instância ───────────────────────────────────────────────
# OBRIGATÓRIO: nome legível da instituição
PICSAUDE_INSTANCE_NAME=Nome da Instituição

# OBRIGATÓRIO: identificador único da organização (ex: HOSPITAL-RECIFE-001, HOSP-ABC)
# Usado como org_id nos escopos institucionais e em /health/version
PICSAUDE_INSTANCE_ORG_ID=TROCAR_POR_CODIGO_INSTITUCIONAL

# Versão do núcleo PicSaúde instalado (não alterar manualmente)
PICSAUDE_VERSION=1.0.0

# Ambiente: dev | hml | prod
PICSAUDE_ENV=prod

# ── Banco de dados ───────────────────────────────────────────────────────────
# Caminho interno ao container (não alterar, a menos que mude o Dockerfile)
PIX_SAUDE_DB=/data/picsaude.db

# ── Servidor ─────────────────────────────────────────────────────────────────
# Porta exposta ao host
PICSAUDE_PORT=8080

# OBRIGATÓRIO: URL base pública (usada em QR Codes e links de PDF)
# Exemplos: http://192.168.1.10:8080  |  https://picsaude.minhainstituicao.edu.br
PICSAUDE_BASE_URL=http://localhost:8080

# ── Segurança ────────────────────────────────────────────────────────────────
# OBRIGATÓRIO: chave JWT — gerar com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Nunca use o valor de exemplo em produção.
PICSAUDE_JWT_SECRET=TROCAR_POR_CHAVE_ALEATORIA_64_CHARS_HEX

# Expiração dos tokens de acesso (minutos)
PICSAUDE_JWT_TTL_MIN=60

# Expiração dos refresh tokens (minutos) — padrão: 24h
PICSAUDE_JWT_REFRESH_MIN=1440

# ── Admin inicial ─────────────────────────────────────────────────────────────
# Criado pelo bootstrap.sh na primeira execução — idempotente
# OBRIGATÓRIO: e-mail do administrador inicial
PICSAUDE_ADMIN_EMAIL=admin@minhainstituicao.br

# OBRIGATÓRIO: nome do administrador
PICSAUDE_ADMIN_NOME=Administrador PicSaúde

# OBRIGATÓRIO: senha inicial — TROQUE IMEDIATAMENTE após o primeiro login
# Mínimo 12 caracteres recomendado.
PICSAUDE_ADMIN_SENHA=TROCAR_IMEDIATAMENTE

# ── Funcionalidades ──────────────────────────────────────────────────────────
# Outbox de eventos externos (G4A)
PICSAUDE_OUTBOX_ENABLED=true

# ── Backup (opcional) ────────────────────────────────────────────────────────
# Diretório de backups dentro do volume
PICSAUDE_BACKUP_DIR=/data/backups

# Para ativar backup agendado via cron (descomentar e ajustar):
# PICSAUDE_BACKUP_CRON=0 2 * * *
